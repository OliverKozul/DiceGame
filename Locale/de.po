msgstr "Urzeitlindwurm"

#: Resources/Enemies/AncientWyrm.tres:9
msgid "Older than the mountains."
msgstr "Älter als die Berge."

#: Resources/Enemies/BoneColossus.tres:8
msgid "Bone Colossus"
msgstr "Knochenkoloss"

#: Resources/Enemies/BoneColossus.tres:9
msgid "A giant of a thousand graves."
msgstr "Ein Riese aus tausend Gräbern."

#: Resources/Enemies/CaveTroll.tres:11
msgid "Cave Troll"
msgstr "Höhlentroll"

#: Resources/Enemies/CaveTroll.tres:12
msgid "Big, slow and hungry."
msgstr "Groß, langsam und hungrig."

#: Resources/Enemies/DemonPrince.tres:8
msgid "Demon Prince"
msgstr "Dämonenprinz"

#: Resources/Enemies/DemonPrince.tres:9
msgid "Every bargain has a price."
msgstr "Jeder Handel hat seinen Preis."

#: Resources/Enemies/EldritchHorror.tres:8
msgid "Eldritch Horror"
msgstr "Uraltes Grauen"

#: Resources/Enemies/EldritchHorror.tres:9
msgid "It should not be."
msgstr "Es dürfte nicht sein."

#: Resources/Enemies/GiantBats.tres:11
msgid "Giant Bats"
msgstr "Riesenfledermäuse"

#: Resources/Enemies/GiantBats.tres:12
msgid "A shrieking cloud of wings."
msgstr "Eine kreischende Wolke aus Flügeln."

#: Resources/Enemies/GoblinThief.tres:10
msgid "Goblin Thief"
msgstr "Koboldsdieb"

#: Resources/Enemies/GoblinThief.tres:11
msgid "Quick fingers, quicker feet."
msgstr "Flinke Finger, flinkere Füße."

#: Resources/Enemies/Highwayman.tres:11
msgid "Highwayman"
msgstr "Wegelagerer"

#: Resources/Enemies/Highwayman.tres:12
msgid "Your purse or your life."
msgstr "Geld oder Leben."

#: Resources/Enemies/Lich.tres:12
msgid "Lich"
msgstr "Lich"

#: Resources/Enemies/Lich.tres:13
msgid "It has outlived every promise it made."
msgstr "Er hat jedes seiner Versprechen überlebt."

#: Resources/Enemies/OgreChief.tres:12
msgid "Ogre Chief"
msgstr "Ogerhäuptling"

#: Resources/Enemies/OgreChief.tres:13
msgid "Leads by smashing."
msgstr "Führt mit der Keule."

#: Resources/Enemies/RatKing.tres:11
msgid "Rat King"
msgstr "Rattenkönig"

#: Resources/Enemies/RatKing.tres:12
msgid "Crowned by his own tail."
msgstr "Gekrönt von seinem eigenen Schwanz."

#: Resources/Enemies/RedDragon.tres:9
msgid "A fierce dragon."
msgstr "Ein wilder Drache."

#: Resources/Enemies/StoneGolem.tres:12
msgid "Stone Golem"
msgstr "Steingolem"

#: Resources/Enemies/StoneGolem.tres:13
msgid "Slow to wake, slower to fall."
msgstr "Langsam erwacht, noch langsamer gefallen."

#: Resources/Enemies/SwampWitch.tres:12
msgid "Swamp Witch"
msgstr "Sumpfhexe"

#: Resources/Enemies/SwampWitch.tres:13
msgid "She brews what she catches."
msgstr "Sie braut, was sie fängt."

#: Resources/Enemies/TrollKing.tres:8
msgid "Troll King"
msgstr "Trollkönig"

#: Resources/Enemies/TrollKing.tres:9
msgid "He wears the last crown he ate."
msgstr "Er trägt die letzte Krone, die er gefressen hat."

#: Resources/Enemies/VampireLord.tres:10
msgid "Vampire Lord"
msgstr "Vampirfürst"

#: Resources/Enemies/VampireLord.tres:11
msgid "He never refuses an invitation."
msgstr "Eine Einladung schlägt er nie aus."

#: Resources/Enemies/Werewolf.tres:11
msgid "Werewolf"
msgstr "Werwolf"

#: Resources/Enemies/Werewolf.tres:12
msgid "A neighbour by day."
msgstr "Tagsüber ein Nachbar."

#: Resources/Enemies/Wraith.tres:11
msgid "Wraith"
msgstr "Gespenst"

#: Resources/Enemies/Wraith.tres:12
msgid "A whisper with claws."
msgstr "Ein Flüstern mit Klauen."

#: Resources/Trinkets/BackstabDagger.tres:8
msgid "Backstab Dagger"
msgstr "Meuchelmesser"

#: Resources/Trinkets/BackstabDagger.tres:9
msgid "+2 {combat} attack when you attack a player you did not declare."
msgstr "+2 {combat} Angriff, wenn du einen Spieler angreifst, den du nicht angekündigt hast."

#: Resources/Trinkets/BoneDice.tres:8
msgid "Bone Dice"
msgstr "Knochenwürfel"

#: Resources/Trinkets/BoneDice.tres:9
msgid "Your second reroll each turn is free as well."
msgstr "Auch dein zweiter Neuwurf jeder Runde ist gratis."

#: Resources/Trinkets/CoinMagnet.tres:8
msgid "Coin Magnet"
msgstr "Münzmagnet"

#: Resources/Trinkets/CoinMagnet.tres:9
msgid "When your attack damages a player, you also steal 1 {gold} from them."
msgstr "Wenn dein Angriff einem Spieler schadet, stiehlst du ihm außerdem 1 {gold}."

#: Resources/Trinkets/CrownOfHonor.tres:8
msgid "Crown of Honor"
msgstr "Ehrenkrone"

#: Resources/Trinkets/CrownOfHonor.tres:9
msgid "+2 extra {renown} whenever you complete an oath."
msgstr "+2 zusätzlicher {renown}, wann immer du einen Schwur erfüllst."

#: Resources/Trinkets/Dragonscale.tres:8
msgid "Dragonscale"
msgstr "Drachenschuppe"

#: Resources/Trinkets/Dragonscale.tres:9
msgid "+2 {guard} guard every turn."
msgstr "+2 {guard} Deckung in jeder Runde."

#: Resources/Trinkets/FoxMask.tres:8
msgid "Fox Mask"
msgstr "Fuchsmaske"

#: Resources/Trinkets/FoxMask.tres:9
msgid "+1 {cunning} every turn, plus 1 for every cunning face you roll."
msgstr "+1 {cunning} in jeder Runde, plus 1 für jede gewürfelte List-Seite."

#: Resources/Trinkets/GobletOfBlood.tres:8
msgid "Goblet of Blood"
msgstr "Blutkelch"

#: Resources/Trinkets/GobletOfBlood.tres:9
msgid "When your attack deals damage, heal 1 {heal}, plus 1 for every 5 damage."
msgstr "Wenn dein Angriff Schaden verursacht, heilst du 1 {heal}, plus 1 je 5 Schaden."

#: Resources/Trinkets/GoldenIdol.tres:8
msgid "Golden Idol"
msgstr "Goldener Götze"

#: Resources/Trinkets/GoldenIdol.tres:9
msgid "+2 {gold} every turn."
msgstr "+2 {gold} in jeder Runde."

#: Resources/Trinkets/HerbalPouch.tres:8
msgid "Herbal Pouch"
msgstr "Kräuterbeutel"

#: Resources/Trinkets/HerbalPouch.tres:9
msgid "Resting heals 2 more {heal}."
msgstr "Rasten heilt 2 {heal} mehr."

#: Resources/Trinkets/HuntersHorn.tres:8
msgid "Hunter's Horn"
msgstr "Jagdhorn"

#: Resources/Trinkets/HuntersHorn.tres:9
msgid "+2 {combat} attack when you attack a mob."
msgstr "+2 {combat} Angriff, wenn du ein Monster angreifst."

#: Resources/Trinkets/LiarsMask.tres:8
msgid "Liar's Mask"
msgstr "Lügnermaske"

#: Resources/Trinkets/LiarsMask.tres:9
msgid "Breaking your word does not start your oath over."
msgstr "Ein gebrochenes Wort setzt deinen Schwur nicht zurück."

#: Resources/Trinkets/LuckyCoin.tres:8
msgid "Lucky Coin"
msgstr "Glücksmünze"

#: Resources/Trinkets/LuckyCoin.tres:9
msgid "+1 {gold} for every gold face you roll."
msgstr "+1 {gold} für jede gewürfelte Gold-Seite."

#: Resources/Trinkets/MerchantsSeal.tres:8
msgid "Merchant's Seal"
msgstr "Händlersiegel"

#: Resources/Trinkets/MerchantsSeal.tres:9
msgid "Faces, upgrades and dice cost you 1 {gold} less (never less than 1)."
msgstr "Seiten, Verbesserungen und Würfel kosten dich 1 {gold} weniger (nie weniger als 1)."

#: Resources/Trinkets/Opportunity.tres:8
msgid "Opportunity"
msgstr "Gelegenheit"

#: Resources/Trinkets/Opportunity.tres:9
msgid "Gain an extra die: {combat}2 {combat}2 {gold}2 {gold}2 {cunning}1 {cunning}1."
msgstr "Erhalte einen zusätzlichen Würfel: {combat}2 {combat}2 {gold}2 {gold}2 {cunning}1 {cunning}1."

#: Resources/Trinkets/PhoenixFeather.tres:8
msgid "Phoenix Feather"
msgstr "Phönixfeder"

#: Resources/Trinkets/PhoenixFeather.tres:9
msgid "Come back from a knockout at full {heal} health."
msgstr "Kehre nach einem K.o. mit voller {heal} Gesundheit zurück."

#: Resources/Trinkets/SharpTooth.tres:8
msgid "Sharp Tooth"
msgstr "Scharfer Zahn"

#: Resources/Trinkets/SharpTooth.tres:9
msgid "+1 {combat} for every combat face you roll."
msgstr "+1 {combat} für jede gewürfelte Kampf-Seite."

#: Resources/Trinkets/SilverTongue.tres:8
msgid "Silver Tongue"
msgstr "Silberzunge"

#: Resources/Trinkets/SilverTongue.tres:9
msgid "+1 {gold} whenever you keep your word."
msgstr "+1 {gold}, wann immer du Wort hältst."

#: Resources/Trinkets/SmokeBomb.tres:8
msgid "Smoke Bomb"
msgstr "Rauchbombe"

#: Resources/Trinkets/SmokeBomb.tres:9
msgid "+2 {guard} guard on a turn you break your word."
msgstr "+2 {guard} Deckung in einer Runde, in der du dein Wort brichst."

#: Resources/Trinkets/ThirdEye.tres:8
msgid "Third Eye"
msgstr "Drittes Auge"

#: Resources/Trinkets/ThirdEye.tres:9
msgid "+2 {cunning} every turn, plus 2 more for every cunning face you roll; each cunning face also heals 1 {heal}."
msgstr "+2 {cunning} in jeder Runde, plus 2 mehr für jede gewürfelte List-Seite; jede List-Seite heilt außerdem 1 {heal}."

#: Resources/Trinkets/ThornedMail.tres:8
msgid "Thorned Mail"
msgstr "Dornenpanzer"

#: Resources/Trinkets/ThornedMail.tres:9
msgid "When another player's attack damages you, they take 1 damage."
msgstr "Wenn dir der Angriff eines anderen Spielers schadet, erleidet dieser 1 Schaden."

#: Resources/Trinkets/WarBanner.tres:8
msgid "War Banner"
msgstr "Kriegsbanner"

#: Resources/Trinkets/WarBanner.tres:9
msgid "+1 {combat} attack on every attack you make."
msgstr "+1 {combat} Angriff bei jedem deiner Angriffe."

#: Resources/Trinkets/WyrmHeart.tres:8
msgid "Wyrm Heart"
msgstr "Lindwurmherz"

#: Resources/Trinkets/WyrmHeart.tres:9
msgid "+4 maximum {heal} health, and heal to full."
msgstr "+4 maximale {heal} Gesundheit, und volle Heilung."
